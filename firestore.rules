rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions — read role and stores from Auth Custom Claims (zero extra reads)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }


    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow update, delete: if isAdmin();
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Stores collection
    match /stores/{storeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Pipeline stages
    match /stages/{stageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Leads — scoped to store assignment
    match /leads/{leadId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow create: if isAuthenticated() &&
        (isAdmin() || request.resource.data.storeId in request.auth.token.stores);
      allow update, delete: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
    }

    // Tasks — scoped to store assignment
    match /tasks/{taskId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow create: if isAuthenticated() &&
        (isAdmin() || request.resource.data.storeId in request.auth.token.stores);
      allow update, delete: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
    }

    // Quotations — scoped to store assignment
    match /quotations/{quotationId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow create: if isAuthenticated() &&
        (isAdmin() || request.resource.data.storeId in request.auth.token.stores);
      allow update: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow delete: if isAdmin();
    }

    // Sales Orders — scoped to store assignment
    match /salesOrders/{orderId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow create: if isAuthenticated() &&
        (isAdmin() || request.resource.data.storeId in request.auth.token.stores);
      allow update: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow delete: if isAdmin();
    }

    // Dockets — scoped to store assignment
    match /dockets/{docketId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow create: if isAuthenticated() &&
        (isAdmin() || request.resource.data.storeId in request.auth.token.stores);
      allow update: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow delete: if isAdmin();
    }

    // Warranties — scoped to store assignment
    match /warranties/{warrantyId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (isAdmin() || resource.data.storeId in request.auth.token.stores);
      allow delete: if isAdmin();
    }

    // Docket Templates — globally readable, admin writable
    match /docketTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications — users can only read/write their own
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Counters — used for sequential IDs
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Settings — globally readable, admin writable
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
