rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Quotation PDFs — accessible to authenticated users
    match /quotations/{filename} {
      allow read, write: if request.auth != null;
    }
    
    // Dockets and attachments
    match /dockets/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Sales Orders attachments
    match /salesOrders/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
